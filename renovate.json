
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 10am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 5,
  "prCreation": "immediate",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Go toolchain patch updates: create a dedicated PR without waiting for the weekly schedule",
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "matchPackageNames": ["go"],
      "matchUpdateTypes": ["patch"],
      "groupName": "Go toolchain",
      "schedule": ["at any time"],
      "minimumReleaseAge": null,
      "automerge": false,
      "prPriority": 20
    },
    {
      "description": "Go toolchain minor updates: separate PR with full CI verification",
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "matchPackageNames": ["go"],
      "matchUpdateTypes": ["minor"],
      "groupName": "Go toolchain",
      "automerge": false
    },
    {
      "description": "Go toolchain major updates require explicit approval",
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "matchPackageNames": ["go"],
      "matchUpdateTypes": ["major"],
      "groupName": "Go toolchain",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Go module major updates",
      "matchManagers": ["gomod"],
      "matchDatasources": ["go"],
      "matchUpdateTypes": ["major"],
      "groupName": "Go major dependencies",
      "schedule": [
        "before 10am on the first day of the month"
      ],
      "automerge": false
    },
    {
      "description": "golang.org/x packages grouping",
      "matchDatasources": ["go"],
      "matchPackageNames": ["golang.org/x{/,}**"],
      "groupName": "golang.org/x packages",
      "automerge": false
    },
    {
      "description": "GitHub Actions update",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Tool versions pinned in the Makefile (customManagers): one PR for them",
      "matchManagers": ["custom.regex"],
      "groupName": "Development tools",
      "automerge": false
    },
    {
      "description": "Hephaestus: keep the workflow action digest and Makefile version synchronized",
      "matchPackageNames": ["magicdrive/hephaestus"],
      "groupName": "Hephaestus",
      "automerge": false
    },
    {
      "description": "Go module patch updates are not delayed by the weekly schedule",
      "matchManagers": ["gomod"],
      "matchDatasources": ["go"],
      "matchUpdateTypes": ["patch"],
      "schedule": ["at any time"],
      "minimumReleaseAge": null,
      "automerge": false
    },
    {
      "description": "Vulnerable Go modules are given top priority",
      "matchDatasources": ["go"],
      "labels": ["security"],
      "prPriority": 10
    },
    {
      "description": "The Renovate validator, its lockfile, and its required Node.js version move together",
      "matchFileNames": [".github/renovate-check/**"],
      "groupName": "Renovate validator",
      "automerge": false
    },
    {
      "description": "Node.js major updates for the Renovate validator require Dependency Dashboard approval",
      "matchFileNames": [".github/renovate-check/.node-version"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The CI TypeScript compiler is a soundness oracle and must be upgraded deliberately",
      "matchFileNames": [".github/ts-oracle/**"],
      "enabled": false
    }
  ],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 10am on monday"
    ]
  },
  "prHourlyLimit": 2,
  "ignorePaths": [
    "**/testdata/**",
    "**/*.golden"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "osvVulnerabilityAlerts": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned in the Makefile",
      "managerFilePatterns": ["/(^|/)Makefile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+ \\??= (?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Keep staticcheck in CI synchronized with STATICCHECK_VERSION in the Makefile",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "go install honnef\\.co/go/tools/cmd/staticcheck@(?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "honnef.co/go/tools",
      "datasourceTemplate": "go"
    }
  ]
}

