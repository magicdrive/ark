{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 10am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 5,
  "prCreation": "immediate",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Go language dependencies update",
      "matchDatasources": ["go"],
      "matchUpdateTypes": ["major"],
      "groupName": "Go major dependencies",
      "schedule": [
        "before 10am on the first day of the month"
      ]
    },
    {
      "description": "golang.org/x packages grouping",
      "matchDatasources": ["go"],
      "matchPackageNames": ["golang.org/x{/,}**"],
      "groupName": "golang.org/x packages",
      "automerge": false
    },
    {
      "description": "GitHub Actions update",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Tool versions pinned in the Makefile (customManagers): one PR for them",
      "matchManagers": ["custom.regex"],
      "groupName": "Development tools",
      "automerge": false
    },
    {
      "description": "Hephaestus: the action the workflows pin by digest and HEPHAESTUS_VERSION of the Makefile move together (release_workflow_test.go keeps them equal)",
      "matchPackageNames": ["magicdrive/hephaestus"],
      "groupName": "Hephaestus",
      "automerge": false
    },
    {
      "description": "Security patches are provided immediately",
      "matchUpdateTypes": ["patch"],
      "matchDatasources": ["go"],
      "automerge": false,
      "minimumReleaseAge": null
    },
    {
      "description": "Vulnerable packages are given top priority",
      "matchDatasources": ["go"],
      "labels": ["security"],
      "prPriority": 10
    },
    {
      "description": "The CI TypeScript compiler (.github/ts-oracle) is the soundness oracle: upgrade it deliberately, re-running the differential",
      "matchFileNames": [".github/ts-oracle/**"],
      "enabled": false
    }
  ],
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 2,
  "ignorePaths": [
    "**/testdata/**",
    "**/*.golden"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "osvVulnerabilityAlerts": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned in the Makefile, each under a '# renovate: datasource=... depName=...' comment",
      "managerFilePatterns": ["/(^|/)Makefile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+ \\??= (?<currentValue>\\S+)"
      ]
    }
  ]
}
